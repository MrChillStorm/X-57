<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>yoke.ac</path>

  <animation>
    <!-- Objets opaques -->
    <object-name>base</object-name>
    <object-name>yoke</object-name><object-name>hl-button</object-name>

    <!-- Objets transparents -->
  </animation>

  <animation>
    <type>noshadow</type>
    <object-name>base</object-name>
  </animation>

  <animation>
    <type>translate</type>
    <object-name>yoke</object-name><object-name>hl-button</object-name>
    <property>fdm/jsbsim/x57/stab-norm</property>
    <interpolation>
      <entry><ind> -1 </ind><dep>  0.07 </dep></entry>
      <entry><ind>  0 </ind><dep>  0.00 </dep></entry>
      <entry><ind>  1 </ind><dep> -0.07 </dep></entry>
    </interpolation>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>yoke</object-name><object-name>hl-button</object-name>
    <property>surface-positions/left-aileron-pos-norm</property>
    <interpolation>
      <entry><ind> -1 </ind><dep>  50 </dep></entry>
      <entry><ind>  0 </ind><dep>   0 </dep></entry>
      <entry><ind>  1 </ind><dep> -50 </dep></entry>
    </interpolation>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <!-- Séléction de l'objet visible -->
  <animation>
    <type>select</type>
    <object-name>yoke</object-name><object-name>hl-button</object-name>
    <condition>
      <!-- <property>sim/model/show-yoke</property> -->
      <property>sim/model/x57/show-yoke</property>
    </condition>
  </animation>

<effect><inherits-from>Aircraft/X-57/Models/Effects/x57-red</inherits-from><object-name>hl-button</object-name></effect><animation><type>pick</type><object-name>hl-button</object-name><action><button>0</button><repeatable type="bool">false</repeatable><binding><command>property-toggle</command><property>/sim/model/x57/click/push</property></binding><binding><command>property-assign</command><property>sim/model/x57/hl-yoke</property><value>1</value></binding></action></animation>
<animation><type>pick</type><object-name>base</object-name><action><button>0</button><repeatable type="bool">false</repeatable><binding><command>property-toggle</command><property>/sim/model/x57/click/rocker</property></binding><binding><command>property-toggle</command><property>sim/model/x57/show-yoke</property></binding></action></animation>
<effect><inherits-from>Aircraft/X-57/Models/Effects/x57-face</inherits-from><object-name>base</object-name><object-name>yoke</object-name><object-name>hl-button</object-name></effect>
</PropertyList>
