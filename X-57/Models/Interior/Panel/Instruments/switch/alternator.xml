<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>on-off.ac</path>

  <animation>
    <!-- Objets opaques -->
    <object-name>base</object-name>
    <object-name>on-off</object-name>

    <!-- Objets transparents -->
  </animation>

  <animation>
    <type>noshadow</type>
    <object-name>base</object-name>
    <object-name>on-off</object-name>
  </animation>

  <animation>
    <type>material</type>
    <object-name>on-off</object-name>
    <condition>
      <property>controls/electric/battery-switch</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instruments-norm</factor-prop>
      <red>   0.50 </red>
      <green> 0.40 </green>
      <blue>  0.30 </blue>
    </emission>
  </animation>

  <animation>
    <object-name>on-off</object-name>
    <type>rotate</type>
    <property>controls/engines/engine/master-alt</property>
    <factor> 35 </factor>
    <min-deg>  0 </min-deg>
    <max-deg> 35 </max-deg>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <animation>
    <type>pick</type>
    <object-name>on-off</object-name>
    <visible>true</visible>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding><command>property-toggle</command><property>/sim/model/x57/click/rocker</property></binding><binding>
        <command>property-toggle</command>
        <property>controls/engines/engine/master-alt</property>
      </binding>
    </action>
  </animation>

<effect><inherits-from>Aircraft/X-57/Models/Effects/x57-face</inherits-from><object-name>base</object-name><object-name>on-off</object-name></effect>
</PropertyList>


