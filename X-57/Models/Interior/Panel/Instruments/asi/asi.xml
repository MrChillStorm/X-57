<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>asi.ac</path>

  <animation>
    <object-name>fond</object-name>
    <object-name>face</object-name>
    <object-name>needle</object-name>

    <object-name>vitre</object-name>
  </animation>

  <animation>
    <type>noshadow</type>
    <object-name>fond</object-name>
    <object-name>face</object-name>
    <object-name>needle</object-name>
    <object-name>vitre</object-name>
  </animation>

  <!-- working for Compositor -->
  <effect>
    <inherits-from>Aircraft/X-57/Models/Effects/Glass/instrument-glass</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <animation>
    <type>material</type>
    <object-name>face</object-name>
    <object-name>needle</object-name>
    <condition>
      <property>controls/electric/battery-switch</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instruments-norm</factor-prop>
      <red>   0.50 </red>
      <green> 0.40 </green>
      <blue>  0.30 </blue>
    </emission>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>needle</object-name>
    <property>instrumentation/airspeed-indicator/indicated-speed-kt</property>
    <interpolation>
      <entry><ind>   0 </ind><dep>    0 </dep></entry>
      <entry><ind>  40 </ind><dep>   28 </dep></entry>
      <entry><ind>  60 </ind><dep>   68 </dep></entry>
      <entry><ind>  80 </ind><dep>  120 </dep></entry>
      <entry><ind> 100 </ind><dep>  170 </dep></entry>
      <entry><ind> 120 </ind><dep>  205 </dep></entry>
      <entry><ind> 140 </ind><dep>  238 </dep></entry>
      <entry><ind> 120 </ind><dep>  205 </dep></entry>
      <entry><ind> 160 </ind><dep>  269 </dep></entry>
      <entry><ind> 180 </ind><dep>  305 </dep></entry>
      <entry><ind> 200 </ind><dep>  340 </dep></entry>
    </interpolation>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

<effect><inherits-from>Aircraft/X-57/Models/Effects/x57-face</inherits-from><object-name>face</object-name><object-name>fond</object-name><object-name>needle</object-name></effect>
</PropertyList>
