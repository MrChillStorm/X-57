  <animation>
    <type>select</type>
    <object-name>illumination</object-name>
    <condition>
      <and>
        <property>controls/electric/battery-switch</property>
        <property>instrumentation/kns80/serviceable</property>
      </and>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>display.digit</object-name>
    <condition>
      <or>
        <equals>
          <property>instrumentation/kns80/display</property>
          <property>instrumentation/kns80/use</property>
        </equals>
        <less-than>
          <expression>
            <mod>
              <product>
                <dif>
                  <property>sim/time/elapsed-sec</property>
                  <property>instrumentation/kns80/display-timer</property>
                </dif>
                <value>2</value>
              </product>
              <value>2</value>
            </mod>
          </expression>
          <value>1</value>
        </less-than>
      </or>
    </condition>
  </animation>

  <!-- digit display -->
  <animation>
    <type>select</type>
    <object-name>frequencies</object-name>
    <condition>
      <equals>
        <property>instrumentation/kns80/data-mode</property>
        <value>0</value>
      </equals>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>radials</object-name>
    <condition>
      <equals>
        <property>instrumentation/kns80/data-mode</property>
        <value>1</value>
      </equals>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>distance</object-name>
    <condition>
      <equals>
        <property>instrumentation/kns80/data-mode</property>
        <value>2</value>
      </equals>
    </condition>
  </animation>

  <!-- DME display -->
  <animation>
    <type>select</type>
    <object-name>dme.invalid</object-name>
    <condition>
      <and>
        <property>instrumentation/kns80/serviceable</property>
        <not><property>instrumentation/dme/in-range</property></not>
      </and>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>dme-on</object-name>
    <condition>
      <and>
        <property>instrumentation/kns80/serviceable</property>
        <property>instrumentation/dme/in-range</property>
      </and>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>nm.101</object-name>
    <condition>
      <greater-than-equals>
        <property>instrumentation/kns80/dme/indicated-distance-nm</property>
        <value>99.95</value>
      </greater-than-equals>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>nm.102</object-name>
    <condition>
      <greater-than-equals>
        <property>instrumentation/kns80/dme/indicated-distance-nm</property>
        <value>9.95</value>
      </greater-than-equals>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>kt.101</object-name>
    <condition>
      <greater-than-equals>
        <property>instrumentation/kns80/dme/indicated-ground-speed-kt</property>
        <value>99.5</value>
      </greater-than-equals>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>kt.102</object-name>
    <condition>
      <greater-than-equals>
        <property>instrumentation/kns80/dme/indicated-ground-speed-kt</property>
        <value>9.5</value>
      </greater-than-equals>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>min.101</object-name>
    <condition>
      <greater-than-equals>
        <property>instrumentation/kns80/dme/indicated-time-min</property>
        <value>9.5</value>
      </greater-than-equals>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>dist.101</object-name>
    <condition>
      <greater-than-equals>
        <property>instrumentation/kns80/displayed-distance</property>
        <value>99.95</value>
      </greater-than-equals>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>dist.102</object-name>
    <condition>
      <greater-than-equals>
        <property>instrumentation/kns80/displayed-distance</property>
        <value>9.95</value>
      </greater-than-equals>
    </condition>
  </animation>

  <!-- NAV mode -->
  <animation>
    <type>select</type>
    <object-name>vor.annun</object-name>
    <condition>
      <and>
        <property>instrumentation/kns80/serviceable</property>
        <equals>
          <property>instrumentation/kns80/nav-mode</property>
          <value>0</value>
        </equals>
      </and>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>par.annun</object-name>
    <condition>
      <and>
        <property>instrumentation/kns80/serviceable</property>
        <equals>
          <property>instrumentation/kns80/nav-mode</property>
          <value>1</value>
        </equals>
      </and>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>enr.annun</object-name>
    <condition>
      <and>
        <property>instrumentation/kns80/serviceable</property>
        <equals>
          <property>instrumentation/kns80/nav-mode</property>
          <value>2</value>
        </equals>
      </and>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>apr.annun</object-name>
    <condition>
      <and>
        <property>instrumentation/kns80/serviceable</property>
        <equals>
          <property>instrumentation/kns80/nav-mode</property>
          <value>3</value>
        </equals>
      </and>
    </condition>
  </animation>

  <!-- DME hold -->
  <animation>
    <type>select</type>
    <object-name>hld.annun</object-name>
    <condition>
      <and>
        <property>instrumentation/kns80/serviceable</property>
        <property>instrumentation/kns80/dme-hold</property>
      </and>
    </condition>
  </animation>

  <!-- ILS -->
  <animation>
    <type>select</type>
    <object-name>ils.annun</object-name>
    <condition>
      <and>
        <property>instrumentation/kns80/serviceable</property>
        <property>instrumentation/nav/has-gs</property>
        <property>instrumentation/nav/in-range</property>
      </and>
    </condition>
  </animation>

  <!-- Frequency -->
  <animation>
