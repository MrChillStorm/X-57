  <!-- ######################################################################## -->
  <!-- ############################## Animations ############################## -->
  <!-- ######################################################################## -->
  <!-- power-volume-ident knob -->
  <animation>
    <type>rotate</type>
    <object-name>KNS80.volume</object-name>
    <property>instrumentation/nav[0]/volume</property>
    <interpolation>
      <entry><ind> 0 </ind><dep>   0 </dep></entry>
      <entry><ind> 1 </ind><dep> 300 </dep></entry>
    </interpolation>
    <center>
      <x-m>  0.003 </x-m>
      <y-m>  0.040 </y-m>
      <z-m> -0.030 </z-m>
    </center>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <animation>
    <type>translate</type>
    <object-name>KNS80.volume</object-name>
    <property>instrumentation/nav/ident</property>
    <factor>0.005</factor>
