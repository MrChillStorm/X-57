<?xml version="1.0"?>
<!-- the Tecnam's instrument light dimmers [AFM 7.17 fig. 17, 13], written by fdm/x57tecnam.py: fitted from the X-57 menu -->
<PropertyList>
<path>lightpanel-x57.ac</path>
<animation><type>select</type><object-name>base</object-name><object-name>btn-panel</object-name><object-name>btn-instr</object-name><object-name>btn-other</object-name><condition><property>sim/model/x57/tecnam-lights</property></condition></animation>
<animation><type>knob</type><drag-direction>vertical</drag-direction><object-name>btn-panel</object-name><action><binding><command>property-adjust</command><property>/controls/lighting/switches-norm</property><min>0</min><max>1</max><factor>0.02</factor></binding></action><hovered><binding><command>set-tooltip</command><tooltip-id>tecnam-switches</tooltip-id><label>Switch lights: %3d%%</label><property>/controls/lighting/switches-norm</property><mapping>percent</mapping></binding></hovered></animation>
<animation><type>rotate</type><object-name>btn-panel</object-name><property>/controls/lighting/switches-norm</property><factor>270</factor><center><x-m>0.00052</x-m><y-m>-0.03000</y-m><z-m>0</z-m></center><axis><x>-1</x><y>0</y><z>0</z></axis></animation>
<animation><type>knob</type><drag-direction>vertical</drag-direction><object-name>btn-instr</object-name><action><binding><command>property-adjust</command><property>/controls/lighting/avionics-norm</property><min>0</min><max>1</max><factor>0.02</factor></binding></action><hovered><binding><command>set-tooltip</command><tooltip-id>tecnam-avionics</tooltip-id><label>Avionics lights: %3d%%</label><property>/controls/lighting/avionics-norm</property><mapping>percent</mapping></binding></hovered></animation>
<animation><type>rotate</type><object-name>btn-instr</object-name><property>/controls/lighting/avionics-norm</property><factor>270</factor><center><x-m>0.00052</x-m><y-m>0.00000</y-m><z-m>0</z-m></center><axis><x>-1</x><y>0</y><z>0</z></axis></animation>
<animation><type>knob</type><drag-direction>vertical</drag-direction><object-name>btn-other</object-name><action><binding><command>property-adjust</command><property>/controls/lighting/cockpit-norm</property><min>0</min><max>1</max><factor>0.02</factor></binding></action><hovered><binding><command>set-tooltip</command><tooltip-id>tecnam-cockpit</tooltip-id><label>Cockpit lights: %3d%%</label><property>/controls/lighting/cockpit-norm</property><mapping>percent</mapping></binding></hovered></animation>
<animation><type>rotate</type><object-name>btn-other</object-name><property>/controls/lighting/cockpit-norm</property><factor>270</factor><center><x-m>0.00052</x-m><y-m>0.03000</y-m><z-m>0</z-m></center><axis><x>-1</x><y>0</y><z>0</z></axis></animation>
</PropertyList>
