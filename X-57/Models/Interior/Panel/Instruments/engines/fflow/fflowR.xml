<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>fflow.ac</path>

  <animation>
    <object-name>PPHBezel</object-name>
    <object-name>PPHFace</object-name>
    <object-name>PPH.needle</object-name>

    <object-name>vitre</object-name>
  </animation>

  <animation>
    <type>noshadow</type>
    <object-name>PPHBezel</object-name>
    <object-name>PPHFace</object-name>
    <object-name>PPH.needle</object-name>
    <object-name>vitre</object-name>
  </animation>

  <!-- working for Compositor -->
  <effect>
    <inherits-from>Aircraft/X-57/Models/Effects/Glass/instrument-glass</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <animation>
    <type>material</type>
    <object-name>PPHFace</object-name>
    <object-name>PPH.needle</object-name>
    <condition>
      <property>controls/electric/battery-switch</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instruments-norm</factor-prop>
      <red>   0.50 </red>
      <green> 0.40 </green>
      <blue>  0.30 </blue>
    </emission>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>PPH.needle</object-name>
    <property>engines/engine[1]/fuel-flow-gph</property>
    <condition>
      <property>/engines/engine[1]/running</property>
    </condition>
    <interpolation>
      <entry><ind>   0 </ind><dep>   0 </dep></entry>
      <entry><ind> 119 </ind><dep> 240 </dep></entry>
    </interpolation>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

<effect><inherits-from>Aircraft/X-57/Models/Effects/x57-face</inherits-from><object-name>PPH.needle</object-name><object-name>PPHBezel</object-name><object-name>PPHFace</object-name></effect>
</PropertyList>
