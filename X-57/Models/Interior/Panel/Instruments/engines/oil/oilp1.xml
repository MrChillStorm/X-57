<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>oilp.ac</path>

  <animation>
    <object-name>OilBezel</object-name>
    <object-name>OilFace</object-name>
    <object-name>Oil.needle1</object-name>
    <object-name>Oil.needle2</object-name>

    <object-name>vitre</object-name>
  </animation>

  <!-- working for Rembrandt -->
  <animation>
    <type>noshadow</type>
    <object-name>OilBezel</object-name>
    <object-name>OilFace</object-name>
    <object-name>Oil.needle1</object-name>
    <object-name>Oil.needle2</object-name>
    <object-name>vitre</object-name>
  </animation>

  <!-- working for Compositor -->
  <effect>
    <inherits-from>Aircraft/X-57/Models/Effects/Glass/instrument-glass</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <animation>
    <type>material</type>
    <object-name>OilFace</object-name>
    <object-name>Oil.needle1</object-name>
    <object-name>Oil.needle2</object-name>
    <condition>
      <property>controls/electric/battery-switch</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instruments-norm</factor-prop>
      <red>   0.50 </red>
      <green> 0.40 </green>
      <blue>  0.30 </blue>
    </emission>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>Oil.needle1</object-name>
    <property>engines/engine[1]/oil-temperature-degC</property>
    <condition>
      <property>/engines/engine[1]/running</property>
    </condition>
    <interpolation>
      <entry><ind>   0 </ind><dep>  0 </dep></entry>
      <entry><ind> 110 </ind><dep> 90 </dep></entry>
    </interpolation>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>Oil.needle2</object-name>
    <property>engines/engine[1]/oil-pressure-psi</property>
    <condition>
      <property>/engines/engine[1]/running</property>
    </condition>
    <interpolation>
      <entry><ind>    0 </ind><dep>  0 </dep></entry>
      <entry><ind> 5000 </ind><dep> 70 </dep></entry>
    </interpolation>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

<effect><inherits-from>Aircraft/X-57/Models/Effects/x57-face</inherits-from><object-name>Oil.needle1</object-name><object-name>Oil.needle2</object-name><object-name>OilBezel</object-name><object-name>OilFace</object-name></effect>
</PropertyList>
