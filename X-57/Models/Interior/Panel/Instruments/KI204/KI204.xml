<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>KI204.ac</path>

  <animation>
    <object-name>Bezel</object-name>
    <object-name>OBS</object-name>
    <object-name>Bearing</object-name>
    <object-name>Face</object-name>
    <object-name>GSNeedle</object-name>
    <object-name>NavNeedle</object-name>
    <object-name>PointerFrom</object-name>
    <object-name>PointerTo</object-name>
    <object-name>Scale</object-name>

    <object-name>vitre</object-name>
  </animation>

  <animation>
    <type>noshadow</type>
    <object-name>Bezel</object-name>
    <object-name>OBS</object-name>
    <object-name>Bearing</object-name>
    <object-name>Face</object-name>
    <object-name>GSNeedle</object-name>
    <object-name>NavNeedle</object-name>
    <object-name>PointerFrom</object-name>
    <object-name>PointerTo</object-name>
    <object-name>Scale</object-name>
    <object-name>vitre</object-name>
  </animation>

  <!-- working for Compositor -->
  <effect>
    <inherits-from>Aircraft/X-57/Models/Effects/Glass/instrument-glass</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <animation>
    <type>material</type>
    <object-name>Bearing</object-name>
    <object-name>Face</object-name>
    <object-name>GSNeedle</object-name>
    <object-name>NavNeedle</object-name>
    <object-name>PointerFrom</object-name>
    <object-name>PointerTo</object-name>
    <object-name>Scale</object-name>
    <condition>
      <property>controls/electric/battery-switch</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instruments-norm</factor-prop>
      <red>   0.50 </red>
      <green> 0.40 </green>
      <blue>  0.30 </blue>
    </emission>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>Bearing</object-name>
    <property>/instrumentation/nav[0]/radials/selected-deg</property>
    <factor>-1</factor>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>NavNeedle</object-name>
    <property>/instrumentation/nav[0]/heading-needle-deflection</property>
    <factor>4</factor>
    <min>-30</min>
    <max>30</max>
    <center>
      <x-m> -0.03 </x-m>
      <y-m>  0.00 </y-m>
      <z-m>  0.00 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 0 </y>
      <z> 1 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>GSNeedle</object-name>
    <property>/instrumentation/nav[0]/gs-needle-deflection</property>
    <factor>4</factor>
    <min>-30</min>
    <max>30</max>
    <center>
      <x-m> -0.03 </x-m>
      <y-m>  0.00 </y-m>
      <z-m>  0.00 </z-m>
    </center>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <animation>
    <type>pick</type>
    <object-name>OBS</object-name>
    <visible>true</visible>
    <action>
      <name>increase</name>
      <button>3</button>
      <repeatable>true</repeatable>
      <binding>
        <command>property-adjust</command>
        <property>/instrumentation/nav[0]/radials/selected-deg</property>
        <step>1</step>
        <min>0</min>
        <max>360</max>
        <wrap>false</wrap>
      </binding>
    </action>
    <action>
      <name>decrease</name>
      <button>4</button>
      <repeatable>true</repeatable>
      <binding>
        <command>property-adjust</command>
        <property>/instrumentation/nav[0]/radials/selected-deg</property>
        <step>-1</step>
        <min>0</min>
        <max>360</max>
        <wrap>false</wrap>
      </binding>
    </action>
  </animation>

<effect><inherits-from>Aircraft/X-57/Models/Effects/x57-face</inherits-from><object-name>Bearing</object-name><object-name>Bezel</object-name><object-name>Face</object-name><object-name>GSNeedle</object-name><object-name>NavNeedle</object-name><object-name>OBS</object-name><object-name>PointerFrom</object-name><object-name>PointerTo</object-name><object-name>Scale</object-name></effect>
</PropertyList>
