    </action><hovered><binding><command>set-tooltip</command><tooltip-id>x57-door-main</tooltip-id><label>Main door: %s</label><property>sim/model/door-positions/crew/position-norm</property><mapping>nasal</mapping><script>var v = arg[0]; var w = getprop('/gear/gear[0]/wow') and getprop('/gear/gear[1]/wow') and getprop('/gear/gear[2]/wow') and 10 > getprop('/gear/gear[0]/rollspeed-ms'); if (!w) return v > 0.01 ? 'open (shuts on the ground)' : 'shut (opens on the ground)'; return v > 0.99 ? 'open, click to shut' : 0.01 > v ? 'shut, click to open' : 'moving';</script></binding></hovered>
